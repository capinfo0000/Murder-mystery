{
  "rules": {
    "games": {
      "$gameId": {
        // 公開読み取り（ルームコードさえあれば誰でも観戦可）
        ".read": true,

        // ゲーム新規作成 OR ホストによる操作
        ".write": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid)",

        "players": {
          "$playerId": {
            // 自分自身のプレイヤーデータのみ変更可（名前・準備完了）
            ".write": "auth != null && auth.uid === $playerId",

            // hasDrawn は false → true への一方向のみ（再ドロー不可）
            "hasDrawn": {
              ".write": "auth != null && auth.uid === $playerId && data.val() != true"
            }
          }
        },

        "cards": {
          "$cardId": {
            // sharedWith: 自分が所有するカードのみ共有可
            "sharedWith": {
              ".write": "auth != null && data.parent().child('ownerId').val() === auth.uid"
            },
            // ownerId: 山札（deck）のカードを自分に引く操作のみ可
            "ownerId": {
              ".write": "auth != null && data.val() === 'deck' && newData.val() === auth.uid"
            }
          }
        },

        "votes": {
          // 自分の投票のみ、1回限り（変更不可）
          "$playerId": {
            ".write": "auth != null && auth.uid === $playerId && !data.exists()"
          }
        },

        "secretMessages": {
          "$msgId": {
            // 新規送信: 送信者のみ作成可
            // 既存メッセージ: 受信者のみ既読マーク可
            ".write": "auth != null && (
              (!data.exists() && newData.child('fromPlayerId').val() === auth.uid) ||
              (data.exists() && data.child('toPlayerId').val() === auth.uid)
            )"
          }
        }
      }
    }
  }
}
